// Prisma schema for Mural Generator
// Local SQLite database - no SQL writing needed!

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./mural-generator.db"
}

// Reference murals from the local directory
model ReferenceMural {
  id              String   @id @default(uuid())
  collectionName  String   // e.g., "aracne"
  designName      String   // e.g., "daffodils"
  colorVariant    String?  // e.g., "galaxy-azul-oscuro" (optional)
  localFilePath   String   @unique // Full path to -design.jpg file
  fileName        String   // Just the filename
  metadata        String?  // JSON string for any extra data
  importedAt      DateTime @default(now())

  // Artistic descriptions (batch-generated)
  artisticDescription     String?   // JSON string following ArtisticDescription schema
  descriptionGeneratedAt  DateTime? // When description was generated

  // Relations
  generatedMurals         GeneratedMural[]
  batchDescriptionJob     BatchDescriptionJob?

  @@index([collectionName, designName])
}

// Generated murals
model GeneratedMural {
  id                String          @id @default(uuid())

  // Reference to source inspiration
  referenceMuralId  String
  referenceMural    ReferenceMural  @relation(fields: [referenceMuralId], references: [id], onDelete: Cascade)

  // Generation details
  prompt            String          // The prompt used (AI-suggested or custom)
  isCustomPrompt    Boolean         @default(false)

  // Output file
  localFilePath     String          // Full path to generated PNG
  fileName          String          // e.g., "generated-2024-12-22-14-30-45-galaxy-azul-oscuro.png"

  // Gemini API details
  modelUsed         String?         // e.g., "gemini-pro-3"
  generationParams  String?         // JSON string of generation parameters

  // Timestamps
  createdAt         DateTime        @default(now())

  @@index([referenceMuralId])
  @@index([createdAt])
}

// Batch description generation jobs
model BatchDescriptionJob {
  id                String    @id @default(uuid())
  referenceMuralId  String    @unique  // One-to-one relationship
  referenceMural    ReferenceMural @relation(fields: [referenceMuralId], references: [id], onDelete: Cascade)

  batchJobId        String    @unique  // Gemini batch job ID (e.g., "operations/1234567890")
  status            String              // Use Gemini's exact strings: JOB_STATE_PENDING, JOB_STATE_RUNNING, JOB_STATE_SUCCEEDED, JOB_STATE_FAILED, JOB_STATE_CANCELLED, JOB_STATE_EXPIRED

  submittedAt       DateTime  @default(now())
  lastPolledAt      DateTime?
  completedAt       DateTime?

  requestPayload    String?   // Full request payload sent to Gemini (for debugging)
  rawResponse       String?   // Full JSON from Gemini (unparsed)
  errorMessage      String?   // Error details if failed

  @@index([status])
  @@index([submittedAt])
}

// Archive for replaced/deleted batch jobs (preserves history forever)
model BatchDescriptionJobArchive {
  id                String    @id @default(uuid())

  // Original job data (preserved from BatchDescriptionJob)
  originalJobId     String    // Original UUID from BatchDescriptionJob
  referenceMuralId  String    // NOT a foreign key - mural may be deleted
  batchJobId        String    // Gemini batch job ID
  status            String    // Status at time of archival

  submittedAt       DateTime
  lastPolledAt      DateTime?
  completedAt       DateTime?

  requestPayload    String?
  rawResponse       String?
  errorMessage      String?

  // Archive metadata
  archivedAt        DateTime  @default(now())
  replacementReason String    // e.g., "STRATEGY_REPLACE_ALL", "STRATEGY_RETRY_FAILED", "MANUAL_DELETION"
  replacedByJobId   String?   // New job ID if replaced (optional)

  @@index([referenceMuralId])
  @@index([archivedAt])
  @@index([status])
}
